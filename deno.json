{
  "imports": {
    "@std/http": "jsr:@std/http@^1.0.21",
    "esbuild": "npm:esbuild@0.20.1"
  },
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-run --allow-read --allow-write build/esbuild-server.ts",
    "build": "deno run --allow-net --allow-env --allow-run --allow-read --allow-write build/esbuild-build.ts",
    "serve": "deno run --allow-net --allow-env --allow-read serve.ts",
    "format": "deno fmt && deno lint --fix",
    "format:lint": "deno lint --fix",
    "format:prettier": "deno fmt",
    "check": "deno fmt --check && deno lint",
    "cache": "deno cache build/esbuild-build.ts build/esbuild-server.ts serve.ts",
    "prettier": "deno run -A npm:prettier --write .",
    "prettier:check": "deno run -A npm:prettier --check .",
    "eslint": "deno run -A npm:eslint . --ext .ts,.js --fix",
    "eslint:check": "deno run -A npm:eslint . --ext .ts,.js",
    "cspell": "deno run -A npm:cspell --no-progress --no-summary \"**/*.{ts,tsx,js,jsx,json,md,css,html}\" --exclude \"static/dist/**\"",
    "knip": "deno run -A npm:knip",
    "knip:ci": "deno run -A npm:knip --reporter compact"
  },
  "fmt": {
    "include": ["**/*.ts", "**/*.js", "**/*.json"],
    "exclude": ["static/code/js/**"]
  },
  "lint": {
    "include": ["**/*.ts", "**/*.js"],
    "exclude": ["static/code/js/**"]
  }
}
